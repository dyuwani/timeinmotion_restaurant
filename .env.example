# Vercel KV — auto-populated when you connect a KV store in the Vercel dashboard.
# For local dev: run `vercel env pull .env.local` after linking the project.
KV_REST_API_URL=your_kv_rest_api_url_here
KV_REST_API_TOKEN=your_kv_rest_api_token_here
KV_REST_API_READ_ONLY_TOKEN=your_kv_read_only_token_here
