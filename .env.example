# Supabase — auto-populated when you connect Supabase in the Vercel dashboard
# (Project → Integrations → Supabase), or set manually if you created the
# project yourself and linked it to Vercel's Environment Variables.
#
# For local dev: run `vercel env pull .env.local` after linking the project.
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Fallback if only the anon key is available (server routes prefer service role):
SUPABASE_ANON_KEY=your_supabase_anon_key_here
